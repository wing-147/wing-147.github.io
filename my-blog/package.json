{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node --disable-proto=throw ./node_modules/hexo-cli/bin/hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "import:manuscript": "node ../scripts/import-manuscript.mjs",
    "server": "node --disable-proto=throw ./node_modules/hexo-cli/bin/hexo server",
    "test": "node --test ../scripts/import-manuscript.test.mjs && node ../scripts/check-blog.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "hexo-util@3.3.0": true
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-lazyload-image": "^1.1.3",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0"
  }
}
